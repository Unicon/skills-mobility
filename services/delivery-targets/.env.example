# Delivery Targets service settings (DELIVERY_TARGETS_ prefix). Copy to .env for local runs.

# LLM adapter mode: "replay" (deterministic committed fixtures, no AWS) or
# "bedrock" (live Amazon Bedrock).
DELIVERY_TARGETS_MODE=replay

# Local HTTP port.
DELIVERY_TARGETS_PORT=8130

# Where stored selection / invocation-log artifacts are written.
DELIVERY_TARGETS_ARTIFACT_DIR=artifact-output/delivery-targets

# Bedrock model id (inference-profile qualified). Verify against the current
# AWS Bedrock model catalog for your account and region.
DELIVERY_TARGETS_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# AWS region for Bedrock.
DELIVERY_TARGETS_AWS_REGION=us-east-1

# Maximum tokens for Bedrock generation.
DELIVERY_TARGETS_MAX_TOKENS=1024

DELIVERY_TARGETS_LOG_LEVEL=INFO
