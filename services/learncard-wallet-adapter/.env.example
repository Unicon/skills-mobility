# LearnCard Wallet Adapter configuration

# Service settings (prefix: LEARNCARD_WALLET_ADAPTER_)
LEARNCARD_WALLET_ADAPTER_PORT=8900
LEARNCARD_WALLET_ADAPTER_LOG_LEVEL=INFO

# Shared LearnCard REST client (prefix: LEARNCARD_ — see libs/learncard-api)
LEARNCARD_API_URL=https://network.learncard.com/api
# Pre-minted scoped bearer JWT — generated by tools/learncard-demo (ADR-0020, PR #54);
# copy the LEARNCARD_API_TOKEN it writes. Minted once on the TS side (#39 spike). Keep secret.
LEARNCARD_API_TOKEN=
