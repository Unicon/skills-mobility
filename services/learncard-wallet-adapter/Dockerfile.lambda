# Container-image Lambda for learncard-wallet-adapter: FastAPI via Mangum behind a Function URL.
# Build from the repo root:
#   docker build -f services/learncard-wallet-adapter/Dockerfile.lambda -t learncard-wallet-adapter-lambda .
FROM public.ecr.aws/lambda/python:3.12

COPY services/learncard-wallet-adapter /build/learncard-wallet-adapter
RUN pip install --no-cache-dir /build/learncard-wallet-adapter[lambda]

CMD ["learncard_wallet_adapter.lambda_handler.handler"]
