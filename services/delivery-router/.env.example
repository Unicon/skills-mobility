# Delivery Router configuration (prefix: DELIVERY_ROUTER_)

DELIVERY_ROUTER_PORT=8800
DELIVERY_ROUTER_LOG_LEVEL=INFO

# Adapter endpoint base URLs (the router dispatches to these). Ports match the
# adapters' own .env.example: issuer 8910 (#48), wallet 8900 (#50) — outside
# Consul's reserved range (8500/8600).
DELIVERY_ROUTER_LEARNCARD_ISSUER_URL=http://127.0.0.1:8910
DELIVERY_ROUTER_LEARNCARD_WALLET_URL=http://127.0.0.1:8900

# Shared delivery mechanics.
DELIVERY_ROUTER_REQUEST_TIMEOUT=30.0
DELIVERY_ROUTER_RETRY_LIMIT=1
