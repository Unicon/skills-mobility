# Container-image Lambda for the Mock LMS: FastAPI via Mangum behind a Function URL.
# Build from the repo root (needs the libs/events workspace path dependency):
#   docker build -f services/mock-lms/Dockerfile.lambda -t mock-lms-lambda .
FROM public.ecr.aws/lambda/python:3.12

# skills-mobility-events is a uv-workspace path dependency, not on PyPI. Install it
# first so the service install below finds the requirement already satisfied
# instead of reaching out to PyPI for it.
COPY libs/events /build/events
COPY services/mock-lms /build/mock-lms
RUN pip install --no-cache-dir /build/events \
 && pip install --no-cache-dir /build/mock-lms[lambda]

# module.function the Lambda runtime imports.
CMD ["mock_lms.lambda_handler.handler"]
