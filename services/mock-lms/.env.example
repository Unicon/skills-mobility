# Mock LMS service configuration (prefix: MOCK_LMS_)

# Emitter: "local" (in-process capture; default) or "eventbridge" (AWS; not wired yet)
MOCK_LMS_EMITTER=local

# When set, the LocalEmitter also forwards each emitted envelope to the Event
# Consumer's /ingest (the local stand-in for EventBridge -> Lambda). Unset ->
# capture-only (events are buffered but never handed off).
MOCK_LMS_EVENT_CONSUMER_URL=http://127.0.0.1:8200

# EventBridge target (used only when MOCK_LMS_EMITTER=eventbridge)
MOCK_LMS_EVENT_BUS_NAME=skills-mobility-poc
MOCK_LMS_AWS_REGION=us-east-1

# CloudFront-layer auth (ADR-0002): fallback role when no X-Demo-Role header is present
MOCK_LMS_DEFAULT_ROLE=instructor

# Emitted-event metadata
MOCK_LMS_ROOT_ACCOUNT_UUID=mock-root-account

# Live emission-log buffer size
MOCK_LMS_EMISSION_LOG_CAPACITY=500
