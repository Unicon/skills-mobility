# LearnCard Profile Resolver configuration

# Service settings (prefix: LEARNCARD_PROFILE_RESOLVER_)
LEARNCARD_PROFILE_RESOLVER_PORT=8700
LEARNCARD_PROFILE_RESOLVER_DB_PATH=learncard-profile-resolver.db
LEARNCARD_PROFILE_RESOLVER_LOG_LEVEL=INFO

# Shared LearnCard REST client (prefix: LEARNCARD_ — see libs/learncard-api)
LEARNCARD_API_URL=https://network.learncard.com/api
# Pre-minted scoped bearer JWT (minted once on the TS side; see #39). Keep secret.
LEARNCARD_API_TOKEN=
