# Container-image Lambda for the LearnCard Issuer Adapter (Node/Express via
# serverless-http — the Node analogue of the Python services' Mangum pattern).
# Build from the repo root:
#   docker build -f services/learncard-issuer-adapter/Dockerfile.lambda -t issuer-lambda .
FROM public.ecr.aws/lambda/nodejs:20 AS build
WORKDIR /build
COPY services/learncard-issuer-adapter/package.json services/learncard-issuer-adapter/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY services/learncard-issuer-adapter/tsconfig.json ./
COPY services/learncard-issuer-adapter/src ./src
RUN npx tsc -p tsconfig.json

FROM public.ecr.aws/lambda/nodejs:20
COPY --from=build /build/node_modules ${LAMBDA_TASK_ROOT}/node_modules
COPY --from=build /build/dist ${LAMBDA_TASK_ROOT}/dist
CMD ["dist/lambda.handler"]
