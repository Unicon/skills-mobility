# LearnCard Issuer Adapter configuration (local dev; gitignored .env)

# HTTP port (default 8910 — outside Consul's reserved range 8300-8302/8500/8600;
# 8000/8100/8200/8400/8700/8800/8900 are taken by the other POC services).
PORT=8910

# Log level: error | warn | info | debug (default info).
LOG_LEVEL=info

# --- LearnCard issuer identity (the issuing institution/service) ---
# Secret seed material used to derive the issuer DID + signing keys. Self-serve:
# any 64-char hex (e.g. `openssl rand -hex 32`) — the adapter creates the service
# profile on first issuance. For the coordinated demo, use the seed minted by
# tools/learncard-demo (ADR-0020). Until set, /healthz reports configured=false.
SECURE_SEED=
# The issuer's LearnCard-network service profile (NOT the recipient's app profile).
PROFILE_ID=
PROFILE_NAME=
