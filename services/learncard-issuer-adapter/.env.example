# LearnCard Issuer Adapter configuration (local dev; gitignored .env)

# HTTP port (default 8910 — outside Consul's reserved range 8300-8302/8500/8600;
# 8000/8100/8200/8400/8700/8800/8900 are taken by the other POC services).
PORT=8910

# Log level: error | warn | info | debug (default info).
LOG_LEVEL=info

# --- LearnCard issuer identity (the issuing institution — the demo "organization") ---
# The signing seed is derived from a public, non-secret label (same scheme as
# tools/learncard-demo, ADR-0020) so the demo reproduces the *provisioned*
# identity's keypair. A registered profile can only be signed for with the seed
# its keys were derived from — a random seed can't issue as an existing identity.
#
# Coordinated demo (default): the "organization" identity tools/learncard-demo
# provisions. SEED_LABEL derives the seed; PROFILE_ID must match that profile.
SEED_LABEL=organization
PROFILE_ID=smi-demo-organization
PROFILE_NAME=SMI Demo Organization
#
# Standalone throwaway identity instead: set a raw SECURE_SEED (e.g.
# `openssl rand -hex 32`) AND a PROFILE_ID that is NOT already registered — the
# adapter creates that new service profile on first issuance. SECURE_SEED, when
# set, overrides SEED_LABEL. Until a seed + profile resolve, /healthz reports
# configured=false.
# SECURE_SEED=
