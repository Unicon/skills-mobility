# LearnCard Issuer Adapter configuration (local dev; gitignored .env)

# HTTP port (default 8500). 8000 Mock LMS / 8100 Context Builder / 8200 Event
# Consumer / 8400 Orchestrator are taken; 8300 is Consul's RPC port — avoid.
PORT=8500

# Log level: error | warn | info | debug (default info).
LOG_LEVEL=info

# --- LearnCard issuer identity (the issuing institution/service) ---
# Secret seed material used to derive the issuer DID + signing keys.
# Obtain from the LearnCard dev environment (issue #39). Until set, the adapter
# runs but issuance is unconfigured (/healthz reports configured=false).
SECURE_SEED=
# The issuer's LearnCard-network service profile (NOT the recipient's app profile).
PROFILE_ID=
PROFILE_NAME=
