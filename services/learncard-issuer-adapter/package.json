{
  "name": "learncard-issuer-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "LearnCard Issuer Adapter — Node/TS service that signs an unsigned OBv3 via the LearnCard SDK (issue #42).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@learncard/init": "^2.4.3",
    "express": "^4.21.2",
    "serverless-http": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
