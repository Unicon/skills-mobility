# Event Consumer configuration (prefix: EVENT_CONSUMER_)

# Local inspectable SQLite store (ADR-0014). Use ":memory:" for ephemeral runs.
EVENT_CONSUMER_DB_PATH=event-consumer.db

# When set, hand off to the real Orchestrator over HTTP (POST /run-workflow).
# Leave unset for capture mode (the handoff envelope is recorded locally instead).
EVENT_CONSUMER_ORCHESTRATOR_URL=http://127.0.0.1:8300

# Root log level for the service (INFO, DEBUG, WARNING, ...). Defaults to INFO.
EVENT_CONSUMER_LOG_LEVEL=INFO
