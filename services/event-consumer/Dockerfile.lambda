# Container-image Lambda for the Event Consumer: FastAPI via Mangum behind a Function URL.
# Build from the repo root:
#   docker build -f services/event-consumer/Dockerfile.lambda -t event-consumer-lambda .
FROM public.ecr.aws/lambda/python:3.12

COPY services/event-consumer /build/event-consumer
RUN pip install --no-cache-dir /build/event-consumer[lambda]

CMD ["event_consumer.lambda_handler.handler"]
