# Container-image Lambda for field-mapping: FastAPI via Mangum behind a Function URL.
# Build from the repo root:
#   docker build -f services/field-mapping/Dockerfile.lambda -t field-mapping-lambda .
FROM public.ecr.aws/lambda/python:3.12

COPY services/field-mapping /build/field-mapping
RUN pip install --no-cache-dir /build/field-mapping[lambda]

CMD ["field_mapping.lambda_handler.handler"]
