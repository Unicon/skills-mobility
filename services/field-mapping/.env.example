# Field Mapping service settings (FIELD_MAPPING_ prefix). Copy to .env for local runs.

# LLM adapter mode: "replay" (deterministic committed fixtures, no AWS) or
# "bedrock" (live — not implemented yet).
FIELD_MAPPING_MODE=replay

# Where stored mapping / synthesis-request / invocation-log artifacts are written.
FIELD_MAPPING_ARTIFACT_DIR=artifact-output/field-mapping

# Reuse a previously stored mapping artifact instead of regenerating (design §13).
FIELD_MAPPING_REUSE_STORED_MAPPING_ARTIFACTS=false

# Repair-retry mode (design §12) — not implemented yet.
FIELD_MAPPING_REPAIR_RETRY_ENABLED=false

FIELD_MAPPING_LOG_LEVEL=INFO
