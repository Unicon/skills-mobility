# Container-image Lambda for the Context Builder: FastAPI via Mangum behind a Function URL.
# Build from the repo root:
#   docker build -f services/context-builder/Dockerfile.lambda -t context-builder-lambda .
FROM public.ecr.aws/lambda/python:3.12

COPY services/context-builder /build/context-builder
RUN pip install --no-cache-dir /build/context-builder[lambda]

CMD ["context_builder.lambda_handler.handler"]
