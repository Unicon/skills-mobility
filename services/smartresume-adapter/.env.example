# SmartResume Adapter configuration (prefix: SMARTRESUME_ADAPTER_)

SMARTRESUME_ADAPTER_PORT=8920
SMARTRESUME_ADAPTER_LOG_LEVEL=INFO

# SmartResume base URL — required, no default (FR-SR-13). Mock SmartResume in
# all current environments (local below; AWS: the deployed mock's URL).
SMARTRESUME_ADAPTER_API_URL=http://127.0.0.1:8930

# OAuth2 client_credentials — must match Mock SmartResume's configured pair
# (FR-MSR-2). These demo defaults are non-secret; real creds (out of source
# control) only matter against a live SmartResume, which is out of POC scope.
SMARTRESUME_ADAPTER_CLIENT_ID=mock-client-id
SMARTRESUME_ADAPTER_ACCESS_KEY=mock-access-key
