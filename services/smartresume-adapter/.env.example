# SmartResume Adapter configuration (prefix: SMARTRESUME_ADAPTER_)

SMARTRESUME_ADAPTER_PORT=8920
SMARTRESUME_ADAPTER_LOG_LEVEL=INFO

# SmartResume base URL. Staging by default; point at the Mock SmartResume for
# offline dev, or prod (https://my.smartresume.com) with real credentials.
SMARTRESUME_ADAPTER_API_URL=http://127.0.0.1:8930

# OAuth2 client_credentials — vendor secrets. Keep out of source control. Any
# non-empty pair works against the Mock SmartResume.
SMARTRESUME_ADAPTER_CLIENT_ID=
SMARTRESUME_ADAPTER_ACCESS_KEY=
