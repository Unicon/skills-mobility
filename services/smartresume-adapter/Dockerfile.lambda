# Container-image Lambda for smartresume-adapter: FastAPI via Mangum behind a Function URL.
# Build from the repo root:
#   docker build -f services/smartresume-adapter/Dockerfile.lambda -t smartresume-adapter-lambda .
FROM public.ecr.aws/lambda/python:3.12

COPY services/smartresume-adapter /build/smartresume-adapter
RUN pip install --no-cache-dir /build/smartresume-adapter[lambda]

CMD ["smartresume_adapter.lambda_handler.handler"]
