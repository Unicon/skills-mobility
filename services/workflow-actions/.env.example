# Workflow Actions LLM Decision Service — example env vars.
# Copy to .env and fill in values for live Bedrock mode.
# Default mode is "replay" (no AWS required).

WORKFLOW_ACTIONS_MODE=replay

# Local HTTP port.
WORKFLOW_ACTIONS_PORT=8140
# WORKFLOW_ACTIONS_MODE=bedrock

WORKFLOW_ACTIONS_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
WORKFLOW_ACTIONS_AWS_REGION=us-east-1
WORKFLOW_ACTIONS_MAX_TOKENS=2048
WORKFLOW_ACTIONS_ARTIFACT_DIR=artifact-output/workflow-actions
WORKFLOW_ACTIONS_LOG_LEVEL=INFO
