# Orchestrator service configuration (prefix: ORCHESTRATOR_)

# Local HTTP port. 8400 avoids Consul's 8300 RPC default.
ORCHESTRATOR_PORT=8400

# Execution-state store (ADR-0014: SQLite locally). Use ":memory:" for ephemeral runs.
ORCHESTRATOR_DB_PATH=orchestrator.db

# Issuer identity stamped into the stubbed OBv3 credential.
ORCHESTRATOR_ISSUER_ID=did:web:poc.skills-mobility.example

# Shared LearnCard delivery config (resolver + router); LEARNCARD_-prefixed, not
# ORCHESTRATOR_-prefixed (per #25 design §4).
LEARNCARD_DELIVERY_CONFIG_REF=phase1-learncard-default

# Fixed pre-provisioned recipient wallet the POC resolves + delivers to (ADR-0020).
# Its LearnCard handle == profileId; matches the demo tooling's DEMO_RECIPIENT_PROFILE_ID.
LEARNCARD_DEMO_RECIPIENT_PROFILE_ID=smi-demo-learner

# Seam URLs: when set, each seam calls the real service over HTTP; leave unset to
# use the built-in Phase-1 stub for that seam.
# ORCHESTRATOR_CONTEXT_BUILDER_URL=
# ORCHESTRATOR_PROFILE_RESOLVER_URL=
# ORCHESTRATOR_DELIVERY_ROUTER_URL=

# Reusable delivery-phase plan lookup, off by default (FR-OR-28).
ORCHESTRATOR_REUSABLE_PLAN_LOOKUP_ENABLED=false

# Root log level for the service entrypoint (INFO, DEBUG, WARNING, ...).
ORCHESTRATOR_LOG_LEVEL=INFO
