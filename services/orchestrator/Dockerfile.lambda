# Container-image Lambda for the Orchestrator: FastAPI via Mangum behind a Function URL.
# Build from the repo root:
#   docker build -f services/orchestrator/Dockerfile.lambda -t orchestrator-lambda .
FROM public.ecr.aws/lambda/python:3.12

COPY services/orchestrator /build/orchestrator
RUN pip install --no-cache-dir /build/orchestrator[lambda]

CMD ["orchestrator.lambda_handler.handler"]
