# Mock SmartResume configuration (prefix: MOCK_SMARTRESUME_)

MOCK_SMARTRESUME_PORT=8930
MOCK_SMARTRESUME_LOG_LEVEL=INFO

# Token endpoint validates the Basic-auth pair against these (FR-MSR-2). Non-secret
# demo constants; the SmartResume adapter must send a matching pair.
MOCK_SMARTRESUME_CLIENT_ID=mock-client-id
MOCK_SMARTRESUME_ACCESS_KEY=mock-access-key
