# Field Synthesis service settings (FIELD_SYNTHESIS_ prefix). Copy to .env for local runs.

# LLM adapter mode: "replay" (deterministic committed fixtures, no AWS) or
# "bedrock" (live Amazon Bedrock).
FIELD_SYNTHESIS_MODE=replay

# Local HTTP port.
FIELD_SYNTHESIS_PORT=8150

# Where stored synthesis-result / invocation-log artifacts are written.
FIELD_SYNTHESIS_ARTIFACT_DIR=artifact-output/field-synthesis

# Bedrock model id (inference-profile qualified). Verify against the current
# AWS Bedrock model catalog for your account and region.
FIELD_SYNTHESIS_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# AWS region for Bedrock.
FIELD_SYNTHESIS_AWS_REGION=us-east-1

# Maximum tokens for Bedrock generation (all placeholders in one call).
FIELD_SYNTHESIS_MAX_TOKENS=2048

# Generation temperature. Non-zero for generative text (ADR-0010: 0.3–0.5); tunable
# without a code change so prompt/model iteration can search it (FR-FS-12/13).
FIELD_SYNTHESIS_TEMPERATURE=0.3

FIELD_SYNTHESIS_LOG_LEVEL=INFO
