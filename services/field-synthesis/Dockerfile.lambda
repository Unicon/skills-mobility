# Container-image Lambda for field-synthesis: FastAPI via Mangum behind a Function URL.
# Build from the repo root:
#   docker build -f services/field-synthesis/Dockerfile.lambda -t field-synthesis-lambda .
FROM public.ecr.aws/lambda/python:3.12

COPY services/field-synthesis /build/field-synthesis
RUN pip install --no-cache-dir /build/field-synthesis[lambda]

CMD ["field_synthesis.lambda_handler.handler"]
