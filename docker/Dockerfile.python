# Shared image for the Python services (the uv workspace). Built once and run
# per-service via the compose `command` — see docker/README.md. The service host
# is 0.0.0.0 (set in the command) so containers can reach each other; the run()
# entrypoints bind 127.0.0.1 for local dev, which we intentionally bypass here.

FROM python:3.12-slim

# uv (pinned) from its official image.
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

WORKDIR /app
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

# Workspace metadata + members. uv.lock is authoritative (frozen).
COPY pyproject.toml uv.lock .python-version ./
COPY libs/ ./libs/
COPY services/ ./services/

RUN uv sync --all-packages --frozen

# The concrete service (module + port) is supplied by the compose `command`.
