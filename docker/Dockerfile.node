# Image for the LearnCard Issuer Adapter (Node/TS) — the one non-Python service.
# Standalone package (its own package.json/lock, not the uv workspace), so the
# build only needs its own dir. express listens on 0.0.0.0 by default, so unlike
# the Python services no host override is needed.

FROM node:22-slim

WORKDIR /app

# Install deps against the committed lockfile first (cache-friendly).
COPY services/learncard-issuer-adapter/package.json services/learncard-issuer-adapter/package-lock.json ./
RUN npm ci

# Build the TS to dist/.
COPY services/learncard-issuer-adapter/tsconfig.json ./
COPY services/learncard-issuer-adapter/src ./src
RUN npm run build

# Port + secrets (SECURE_SEED, PROFILE_ID) come from compose env.
CMD ["node", "dist/server.js"]
