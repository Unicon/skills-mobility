# Config + generated output for `npm run provision` (this file is the committed
# placeholder; the generated .env is gitignored). See ADR-0020.

# --- Inputs: demo identities (public labels + profile ids, not secrets) --------
# Override these to run the demo under a different learner/organization without
# editing code. Labels derive the wallet seeds; profile ids are the network ids.
RECIPIENT_LABEL=learner
RECIPIENT_PROFILE_ID=smi-demo-learner
ORGANIZATION_LABEL=organization
ORGANIZATION_PROFILE_ID=smi-demo-organization

# LearnCloud Network REST base.
LEARNCARD_API_URL=https://network.learncard.com/api

# --- Outputs: written by provision.mjs (the real secrets + resolved ids) -------
# Sender bearer (organization, credentials:write) — copy into the Wallet Adapter
# (#43) + Profile Resolver (#41) .env files.
LEARNCARD_API_TOKEN=
# Recipient read bearer (credentials:read) — used by the read-back (#53).
LEARNCARD_RECIPIENT_API_TOKEN=

DEMO_RECIPIENT_PROFILE_ID=smi-demo-learner
DEMO_RECIPIENT_DID=
DEMO_ORGANIZATION_PROFILE_ID=smi-demo-organization
DEMO_ORGANIZATION_DID=
