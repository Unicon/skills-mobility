# Written by `npm run provision` (this file is the committed placeholder; the
# generated .env is gitignored). See ADR-0020.

# LearnCloud Network REST base.
LEARNCARD_API_URL=https://network.learncard.com/api

# Sender bearer (issuer) — used by the Wallet Adapter (#43) + Profile Resolver (#41).
LEARNCARD_API_TOKEN=

# Recipient read bearer — used by the delivered-credential read-back (#53).
LEARNCARD_RECIPIENT_API_TOKEN=

# Fixed demo recipient identity (seed the resolver mapping with these).
DEMO_RECIPIENT_PROFILE_ID=smi-demo-learner
DEMO_RECIPIENT_DID=
DEMO_ISSUER_PROFILE_ID=smi-demo-issuer
DEMO_ISSUER_DID=
