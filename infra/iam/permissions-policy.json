{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExecutionStateTableCrud",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:584569945336:table/skills-mobility-dev-execution-state",
        "arn:aws:dynamodb:us-east-1:584569945336:table/skills-mobility-dev-execution-state/index/*"
      ]
    },
    {
      "Sid": "BedrockInvoke",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/*",
        "arn:aws:bedrock:*:584569945336:inference-profile/*"
      ]
    }
  ]
}
