# docker-compose interpolation values (copy to a gitignored `.env` at the repo root).
# Only the LearnCard delivery layer needs these; the Phase-1 spine runs without them.
# Source the secrets from the demo provisioning step (tools/learncard-demo, ADR-0020):
# `node tools/learncard-demo/provision.mjs` derives the fixed demo wallets from the
# committed non-secret labels and writes the tokens/seed (which stay gitignored).

# Shared LearnCloud Network REST API (profile-resolver + wallet-adapter).
LEARNCARD_API_URL=https://network.learncard.com/api
# Pre-minted scoped bearer JWT for the sender identity. Secret — leave blank to
# run the adapters/resolver "unconfigured".
LEARNCARD_API_TOKEN=
# Recipient-scoped read token (credentials:read) for the wallet read-back (#53/#55).
LEARNCARD_RECIPIENT_API_TOKEN=

# Issuer adapter (Node) identity — seed-derived signing keys + service profile.
# SECURE_SEED is derived from the committed demo label, not emitted by provision.mjs:
#   sha256("skills-mobility-demo:issuer")
SECURE_SEED=
LEARNCARD_ISSUER_PROFILE_ID=smi-demo-issuer
LEARNCARD_ISSUER_PROFILE_NAME=SMI Demo Issuer
# The issuer's resolvable network DID — stamped as the OBv3 issuer by the
# orchestrator (ORCHESTRATOR_ISSUER_ID). Must resolve, or SDK signing fails.
LEARNCARD_ISSUER_DID=did:web:network.learncard.com:users:smi-demo-issuer

# Fixed pre-provisioned recipient wallet the orchestrator resolves + delivers to.
LEARNCARD_DEMO_RECIPIENT_PROFILE_ID=smi-demo-learner
